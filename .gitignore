# ==============================================================================
# Voxora .gitignore
# ==============================================================================

# --- Environment & Secret Files ---
.env
.env.*
!.env.example
!.env.test.example
api/.env
api/.env.test
!api/.env.example
!api/.env.test.example
ui/.env
ui/.env.local
!ui/.env.example

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node & Next.js ---
node_modules/
ui/node_modules/
.next/
ui/.next/
out/
ui/out/
*.tsbuildinfo
ui/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Runtime, Logs & Audio Buffers ---
logs/
/logs/
*.log
run/
/run/
*.pid
dograh_pcm_cache/
voxora_pcm_cache/
*.wav
*.mp3
*.pcm

# --- Deployment, Infrastructure & Scratches ---
coturn/
infrastructure/
prd/
.vercel/
.devcontainer/
test-site/

# --- IDEs & OS Files ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Tooling / Local Overrides ---
.conductor/
.superpowers/
docs/superpowers/
.gstack/
.playwright-mcp/
